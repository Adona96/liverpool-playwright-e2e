{
  "name": "liverpool-playwright-e2e",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare":           "npx playwright install --with-deps",
    "install-browsers":  "npx playwright install --with-deps",
    "pretest":           "npm run install-browsers",
    "test":              "playwright test --project=chromium",
    "test:headed":       "cross-env HEADLESS=false playwright test --project=chromium",
    "test:main":         "playwright test liverpool.spec --project=chromium",
    "test:main:headed":  "cross-env HEADLESS=false playwright test liverpool.spec --project=chromium",
    "test:a11y":         "playwright test liverpool.a11y --project=chromium",
    "test:visual":       "cross-env HEADLESS=false playwright test liverpool.visual --project=chromium",
    "test:ci":           "playwright test --project=firefox",
    "report":            "playwright show-report --port 9324"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.0.0"
  }
}